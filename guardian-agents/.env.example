# Guardian Agent System — Environment Variables
# Copy to .env and fill in your values

# ---- Hyperliquid (DATA SOURCE ONLY — no trading) ----
# No API key needed! Info API is public and free.
HL_BASE_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ---- Polymarket (EXECUTION VENUE) ----
POLY_HOST=https://clob.polymarket.com
POLY_CHAIN_ID=137
POLY_PRIVATE_KEY=your_wallet_private_key
POLY_API_KEY=your_polymarket_api_key
POLY_API_SECRET=your_polymarket_api_secret
POLY_API_PASSPHRASE=your_polymarket_api_passphrase
POLY_MAX_POSITION_USD=100
POLY_MIN_CONFIDENCE_TO_TRADE=0.60

# ---- Agent Configuration ----
AGENT_ANTHROPIC_API_KEY=your_anthropic_api_key
AGENT_MODEL=claude-sonnet-4-5-20250929
AGENT_CYCLE_MINUTES=60
AGENT_MIN_CONFIDENCE_TRADE=0.60
AGENT_MAX_DAILY_LOSS_USD=200
AGENT_MAX_CONSECUTIVE_LOSSES=5
AGENT_KELLY_FRACTION=0.25

# Signal weights (must sum to 1.0)
AGENT_WEIGHT_QUANT=0.25
AGENT_WEIGHT_HAWK=0.30
AGENT_WEIGHT_SENTINEL=0.25
AGENT_WEIGHT_SAGE=0.20

# ---- Memory (Mem0) ----
MEM0_API_KEY=your_mem0_api_key
MEM0_USER_ID=guardian-system

# ---- Mission Control Dashboard ----
DASHBOARD_WEBHOOK_URL=https://your-convex-url.convex.site/openclaw/event
DASHBOARD_API_TOKEN=your_dashboard_token
DASHBOARD_TENANT_ID=default

# ---- Monitoring ----
MONITOR_HEALTH_CHECK_INTERVAL=30
MONITOR_MAX_AGENT_RESPONSE_TIME=10.0
MONITOR_ALERT_ON_CONSECUTIVE_FAILURES=3

# ---- General ----
LOG_LEVEL=INFO
ENVIRONMENT=development
