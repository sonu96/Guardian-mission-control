# Convex Configuration
CONVEX_DEPLOYMENT=dev:your-project-name
VITE_CONVEX_URL=https://your-project.convex.cloud

# Discord Webhook (for critical alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Supabase Configuration (for audit trail and analytics)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mem0 Configuration (optional - for agent learning)
MEM0_API_KEY=your-mem0-api-key

# MCP Server URL (for receiving agent updates)
MISSION_CONTROL_URL=http://localhost:5173

# Obsidian CLI Integration (for trading journal)
OBSIDIAN_VAULT=TradingVault
OBSIDIAN_VAULT_PATH=~/Documents/ObsidianVaults/TradingVault

# Environment
NODE_ENV=development
